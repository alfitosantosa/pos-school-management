enum Role {
  BENDAHARA
  ADMIN_BENDAHARA
  DIREKTUR
  SUPER_ADMIN
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  NEED_REVISION
  APPROVED
  REJECTED
  DISBURSED
  IN_USE
  LPJ_SUBMITTED
  LPJ_REVISION
  COMPLETED
  CANCELLED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  REVISION
}

enum ReceiptStatus {
  PENDING
  VALID
  NEED_FIX
}

enum LpjStatus {
  DRAFT
  SUBMITTED
  REVISION
  APPROVED
}

enum SettlementType {
  RETURN_CHANGE
  SHORTFALL
}

model Unit {
  id       String           @id @default(cuid())
