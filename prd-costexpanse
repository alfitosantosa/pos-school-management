  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  unitId       String?
  unit         Unit?    @relation(fields: [unitId], references: [id])
  bankName     String?
  bankAccount  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  requests      ExpenseRequest[] @relation("RequestOwner")
  approvals     Approval[]
  disbursements Disbursement[]
  lpjVerified   Lpj[]            @relation("LpjVerifier")
  auditLogs     AuditLog[]
  notifications Notification[]
}

model Category {
  id       String           @id @default(cuid())
  name     String           @unique
  requests ExpenseRequest[]
  receipts Receipt[]
}

model ExpenseRequest {
  id             String        @id @default(cuid())
  number         String        @unique // contoh: EXP/2026/10/0001
  name           String
  purpose        String?
  neededDate     DateTime
  totalRequested Decimal       @db.Decimal(15, 2)
  totalApproved  Decimal?      @db.Decimal(15, 2)
  status         RequestStatus @default(DRAFT)
  lpjDueDate     DateTime?
  treasurerId    String
  treasurer      User          @relation("RequestOwner", fields: [treasurerId], references: [id])
  unitId         String
  unit           Unit          @relation(fields: [unitId], references: [id])
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  createdAt      DateTime      @default(now())
